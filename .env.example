# APP_NAME: letters, digits and underscores only ([A-Za-z0-9_]+); empty / unset → loongs.
# Checked by start/stop/status/reload/restart. Shown in every process title,
# e.g. loong-swoole[loongs]: master, so several services on one server can be told apart;
# start refuses when a service with the same APP_NAME runs from another project on this host.
APP_NAME=admin
APP_ENV=local
APP_DEBUG=true


# Database (MySQL PDO pool)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=admin_platform
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_SOCKET=/tmp/mysql.sock
DB_POOL_SIZE=16
DB_POOL_WAIT_TIMEOUT=3

# loongs/orm tenant pool (config/database.php tenant_pool)
ORM_POOL_SIZE=8
ORM_POOL_MAX_TENANTS=64
ORM_POOL_IDLE_SECONDS=60
ORM_POOL_TTL=600
ORM_POOL_WAIT_TIMEOUT=3
ORM_POOL_VALIDATE=true


# Redis pool
REDIS_CONNECTION=default
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_AUTH=
REDIS_DB=0
REDIS_TIMEOUT=3.0
REDIS_READ_TIMEOUT=3.0
REDIS_RETRY_INTERVAL=100
REDIS_POOL_SIZE=16
REDIS_POOL_WAIT_TIMEOUT=-1

# Cache (loongs/cache)
CACHE_STORE=file
CACHE_PREFIX=loong:cache:
CACHE_FILE_PATH=runtime/cache
CACHE_REDIS_CONNECTION=default
CACHE_MEMORY_MAX_ITEMS=10000
CACHE_TABLE_SIZE=1024
CACHE_TABLE_VALUE_SIZE=4096

# Process manager / multi-role
# pid / log (and the lock file next to the pid file) default to runtime/loongs.pid / .log / .lock
#PROCESS_PID_FILE=runtime/loongs.pid
#PROCESS_LOG_FILE=runtime/loongs.log
PROCESS_DAEMONIZE=false

# HTTP process
HTTP_ENABLED=true
HTTP_HOST=0.0.0.0
HTTP_PORT=21000
HTTP_WORKER_NUM=1

# RPC process (Loopback/Remote server side)
RPC_ENABLED=true
RPC_HOST=0.0.0.0
RPC_PORT=21001
RPC_WORKER_NUM=1

# WebSocket process
WS_ENABLED=true
WS_HOST=0.0.0.0
WS_PORT=21002
WS_WORKER_NUM=1

# Queue process
QUEUE_ENABLED=false
QUEUE_COUNT=1
QUEUE_CONNECTION=default
QUEUE_QUEUES=default
QUEUE_PREFIX=loong:queue:
QUEUE_TIMEOUT=1

# Crontab process
CRONTAB_ENABLED=false
CRONTAB_SMOKE_ENABLED=false
CRONTAB_SMOKE_RULE=* * * * * *

# Custom example process
CUSTOM_EXAMPLE_ENABLED=false
CUSTOM_EXAMPLE_INTERVAL=2
CUSTOM_EXAMPLE_KEY=loong:process:custom:heartbeat

# RPC io_uring (Swoole --enable-iouring). auto|on|off
# File AIO only for current RPC stack (Http\Server + curl). Network stays epoll.
RPC_IOURING=auto
RPC_IOURING_ENTRIES=8192
RPC_IOURING_WORKERS=0
RPC_IOURING_FLAG=default

# CORS (config/cors.php): comma-separated origins, * = any (dev only)
CORS_ALLOWED_ORIGINS=*
CORS_MAX_AGE=600
# Default public base URL (issuer). Intranet: http://<LAN-IP or internal host>:21000 is fine.
OAUTH_ISSUER=http://127.0.0.1:21000
# Further origins the server is reached under (csv; issuer follows the request origin only if listed;
# "*" = one label/octet, e.g. http://192.168.1.*:21000,http://admin.corp.lan:21000)
OAUTH_ALLOWED_ORIGINS=
# Reverse proxies (IP/CIDR csv) whose X-Forwarded-Proto/Host/Port are trusted; empty = ignore them
TRUSTED_PROXIES=
# Origins serving the Flutter web build (csv): adds <origin>/callback.html to admin-pc + CORS
# Comma-separated browser origins (dev :21080 and packed :21000). Each gets
# <origin>/callback.html and <origin>/admin/web/callback.html on admin-pc.
ADMIN_WEB_ORIGINS=
ADMIN_PC_REDIRECT_URIS=
ADMIN_MOBILE_REDIRECT_URIS=
# WeChat mini program login (bind after password login). Empty = disabled.
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
# Offline code2Session ("mock:<id>" codes) for tests/dev; ignored when APP_ENV=production
WECHAT_MINI_MOCK=false
OAUTH_TOKEN_PEPPER=

# loongs/uploads (config/uploads.php)
UPLOADS_DISK=local
UPLOADS_LOCAL_ROOT=runtime/uploads
UPLOADS_LOCAL_PUBLIC_URL=http://127.0.0.1:21000/uploads
UPLOADS_LOCAL_INTERNAL_URL=http://127.0.0.1:21000/uploads
# UPLOADS_ALIYUN_ACCESS_KEY=
# UPLOADS_ALIYUN_SECRET_KEY=
# UPLOADS_ALIYUN_BUCKET=
# UPLOADS_ALIYUN_ENDPOINT=
# UPLOADS_ALIYUN_DOMAIN=
# UPLOADS_ALIYUN_PRIVATE=false
# UPLOADS_TENCENT_SECRET_ID=
